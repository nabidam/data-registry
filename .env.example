# Backend
DATABASE_URL=postgresql+asyncpg://mtreg:mtreg@postgres:5432/mtreg
DEBUG=true
WORK_DIR=/tmp/mtreg

# Object storage: local | s3 (also MinIO) | gcs
STORAGE_BACKEND=s3
STORAGE_ROOT=/data/storage
S3_BUCKET=mtreg
S3_ENDPOINT_URL=http://minio:9000
S3_REGION=us-east-1
S3_ACCESS_KEY=minioadmin
S3_SECRET_KEY=minioadmin
S3_USE_SSL=false

# Evaluation reservation, applied to every import before anything becomes trainable.
# Reserved per import = min(rows * EVALUATION_PERCENT / 100, EVALUATION_MAX_SAMPLES)
EVALUATION_PERCENT=2.0
EVALUATION_MAX_SAMPLES=5000
EVALUATION_SELECTOR=heuristic
RANDOM_SEED=42

# Experiment tracking (references only)
MLFLOW_TRACKING_URI=
