# Backend
DATABASE_URL=postgresql+asyncpg://mtreg:mtreg@postgres:5432/mtreg
DEBUG=true
WORK_DIR=/tmp/mtreg

# Object storage: local | s3 (also MinIO) | gcs
STORAGE_BACKEND=s3
STORAGE_ROOT=/data/storage
S3_BUCKET=mtreg
S3_ENDPOINT_URL=http://minio:9000
S3_REGION=us-east-1
S3_ACCESS_KEY=minioadmin
S3_SECRET_KEY=minioadmin
S3_USE_SSL=false

# Experiment tracking (references only)
MLFLOW_TRACKING_URI=
