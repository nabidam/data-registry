# Backend. Set this to the PostgreSQL instance managed outside the default Compose stack.
DATABASE_URL=postgresql+psycopg://username:password@postgres-host:5432/mtreg
DEBUG=false
WORK_DIR=/tmp/mtreg

# Large CSV/TSV imports are streamed by the dedicated worker.
IMPORT_STREAM_THRESHOLD_MB=512
IMPORT_BATCH_ROWS=50000
EVALUATION_CANDIDATE_LIMIT=50000
# The expensive selector evaluates at most target × this multiplier, capped by
# EVALUATION_CANDIDATE_LIMIT. A target of 1,000 evaluates 10,000 candidates.
EVALUATION_CANDIDATE_MULTIPLIER=10
# Keep heavy imports from starving the API or the host. Ensure the machine has
# enough headroom for PostgreSQL and MinIO in addition to this worker allowance.
IMPORT_WORKER_CPUS=2.0
IMPORT_WORKER_MEMORY_LIMIT=8g

# Docker build option: install the optional LaBSE/contamination-safe evaluation dependencies.
INSTALL_EVALUATION=false
# Optional host path mounted as the backend's Hugging Face cache.
HOST_HF_CACHE_DIR=${HOME}/.cache/huggingface

# Object storage: local | s3 (also MinIO) | gcs
STORAGE_BACKEND=s3
STORAGE_ROOT=/data/storage
S3_BUCKET=mtreg
S3_ENDPOINT_URL=http://minio:9000
S3_REGION=us-east-1
S3_ACCESS_KEY=minioadmin
S3_SECRET_KEY=minioadmin
S3_USE_SSL=false

# Evaluation reservation, applied to every import before anything becomes trainable.
# Reserved per import = min(rows * EVALUATION_PERCENT / 100, EVALUATION_MAX_SAMPLES)
EVALUATION_PERCENT=2.0
EVALUATION_MAX_SAMPLES=5000
EVALUATION_SELECTOR=heuristic
RANDOM_SEED=42

# Experiment tracking (references only)
MLFLOW_TRACKING_URI=
